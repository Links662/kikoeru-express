{
  "name": "kikoeru-express",
  "version": "0.6.2",
  "description": "A self-hosted media server for listening to your DLsite voice works.",
  "homepage": "https://github.com/kikoeru-project/kikoeru-express",
  "repository": {
    "type": "git",
    "url": "git@github.com:kikoeru-project/kikoeru-express.git"
  },
  "keywords": [
    "kikoeru"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "kikoeru-express": "app.js"
  },
  "nodemonConfig": {
    "ignore": [
      "config/*",
      "sqlite/*"
    ],
    "delay": "2500"
  },
  "scripts": {
    "start": "node --trace-warnings app.js",
    "dev": "nodemon --trace-warnings app.js",
    "scan": "node --trace-warnings ./filesystem/scanner.js",
    "test": "cross-env eslint . && cross-env NODE_ENV=test mocha test/"
  },
  "author": "Watanuki-Kimihiro",
  "contributors": [
    "umonaca <mw2010a@gmail.com>"
  ],
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "axios": "^1.6.0",
    "body-parser": "^1.19.0",
    "cheerio": "^1.0.0",
    "compression": "^1.7.4",
    "connect-history-api-fallback": "^1.6.0",
    "dotenv": "^8.2.0",
    "express": "^5.0.0",
    "express-jwt": "^8.0.0",
    "express-validator": "^6.10.1",
    "htmlparser2": "^4.1.0",
    "jimp": "^0.20.0",
    "jschardet": "^3.0.0",
    "jsonwebtoken": "^9.0.0",
    "knex": "^3.0.0",
    "limit-promise": "^1.0.6",
    "lodash": "^4.17.21",
    "md5": "^2.3.0",
    "natural-orderby": "^2.0.3",
    "recursive-readdir": "^2.2.2",
    "socket.io": "^4.7.0",
    "sqlite3": "^5.0.2",
    "tunnel-agent": "^0.6.0",
    "url-join": "^4.0.1",
    "uuid": "^8.3.2",
    "yargs": "^16.2.0"
  },
  "devDependencies": {
    "chai": "^4.3.4",
    "cross-env": "^7.0.3",
    "eslint": "^7.25.0",
    "eslint-plugin-node": "^11.1.0",
    "mocha": "^8.3.2",
    "serve-index": "^1.9.1"
  }
}
